bucket       = "terraform/init을 apply 하면 나오는 bucket 이름을 작성"
key          = "본인이 원하는 이름.tfstate"
region       = "ap-northeast-2"
profile      = "본인의-aws-프로필명"
use_lockfile = true
encrypt      = true
